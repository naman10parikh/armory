{
  "name": "armory-mcp",
  "version": "0.1.0",
  "description": "The Armory MCP server — search, get, and submit agent-harness components from the Armory registry over stdio. (This is Armory's OWN harness, not one of the cataloged components.)",
  "type": "module",
  "bin": { "armory-mcp": "./dist/index.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist/", "README.md", "LICENSE"],
  "license": "MIT",
  "engines": { "node": ">=18" },
  "keywords": ["ai", "claude", "agent", "mcp", "registry", "armory", "model-context-protocol"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
