{
  "name": "@naman10parikh/armory",
  "version": "0.1.0",
  "description": "Armory — where agents gear up. Install harness components (MCPs, skills, subagents, rules, hooks) into any coding harness.",
  "type": "module",
  "bin": { "armory": "./dist/index.js", "engram": "./dist/index.js" },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist/", "README.md", "LICENSE"],
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "engines": { "node": ">=18" },
  "keywords": ["ai", "claude", "agent", "mcp", "skills", "registry", "dev-tools", "armory", "engram"],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
